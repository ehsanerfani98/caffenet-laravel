{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "caffenet/bazaar-iap",
    "description": "Cafe Bazaar in-app purchase (IAP) and in-app login gateway for Laravel web / PWA applications.",
    "keywords": ["laravel", "cafebazaar", "bazaar", "iap", "in-app-purchase", "payment", "iran", "pwa", "webview"],
    "license": "MIT",
    "type": "library",
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "illuminate/http": "^11.0|^12.0|^13.0",
        "illuminate/database": "^11.0|^12.0|^13.0",
        "illuminate/routing": "^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^10.0|^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Caffenet\\BazaarIap\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Caffenet\\BazaarIap\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Caffenet\\BazaarIap\\BazaarIapServiceProvider"
            ],
            "aliases": {
                "BazaarIap": "Caffenet\\BazaarIap\\Facades\\BazaarIap"
            }
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
