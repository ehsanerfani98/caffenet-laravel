APP_NAME="Caffenet Lite"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=fa
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=debug

# ---------------------------------------------------------------
# Boot-only values (same philosophy as the original .env):
# everything else lives exclusively in the `settings` DB table and
# is managed from the admin panel. Do NOT add app settings here.
# ---------------------------------------------------------------

# SQLite file database (created with: touch database/database.sqlite)
DB_CONNECTION=sqlite

# Private uploads dir (served only through the ownership-checked
# /uploads/:filename route) — default: storage/app/uploads
# UPLOADS_DIR=

# Public slider/media dir served from /media — default: public/media
# MEDIA_DIR=

SESSION_DRIVER=file
QUEUE_CONNECTION=sync
CACHE_STORE=file

MAIL_MAILER=log
