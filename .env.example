APP_NAME="Caffenet Lite"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=fa
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=debug

# ---------------------------------------------------------------
# Boot-only values (same philosophy as the original .env):
# everything else lives exclusively in the `settings` DB table and
# is managed from the admin panel. Do NOT add app settings here.
# ---------------------------------------------------------------

# SQLite file database (created with: touch database/database.sqlite)
DB_CONNECTION=sqlite
# On cPanel shared hosting, set this to the absolute path of your sqlite file:
# DB_DATABASE=/home/USERNAME/laravel/database/database.sqlite

# Order uploads dir — lives under public/ so no storage:link symlink is
# needed on shared hosting. Default: public/uploads
# UPLOADS_DIR=

# Public slider/media dir served from /media — default: public/media
# MEDIA_DIR=

# Smart queue / capacity — database drivers are mandatory on cPanel shared
# hosting (no Redis, no Supervisor, no memcached). All three use the same
# SQLite DB; tables are created by the migration.
SESSION_DRIVER=database
QUEUE_CONNECTION=database
CACHE_STORE=database

# Artisan Runner — for cPanel deployments without SSH access.
# Generate a strong token (e.g. `php -r "echo Str::random(40);"`) and put
# it here. To disable entirely, set to "disabled".
ARTISAN_RUNNER_TOKEN=
# Optional IP whitelist (comma-separated). Leave empty to allow any IP
# (still requires the token above).
# ARTISAN_RUNNER_IPS=203.0.113.10,203.0.113.11

MAIL_MAILER=log
